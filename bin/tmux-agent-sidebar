#!/usr/bin/env bash
# Launcher for the tmux-agent-sidebar TUI.
#
# Resolution order:
#   1. Use an existing, up-to-date release binary.
#   2. Download a prebuilt binary for this platform (users without Rust).
#   3. Build from source with cargo (developers, or unlisted platforms).
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
repo_dir="$(cd "$script_dir/.." && pwd)"
binary="$repo_dir/target/release/tmux-agent-sidebar"

# ratatui/crossterm handle color themselves; a stray NO_COLOR washes out the TUI.
unset NO_COLOR

sources_newer() {
  # True when the checked-out sources are newer than the compiled binary
  # (a developer edited the crate, or `git pull` brought a new version).
  find "$repo_dir/src" "$repo_dir/Cargo.toml" -newer "$binary" -print -quit 2>/dev/null | grep -q .
}

if [[ ! -x "$binary" ]] || sources_newer; then
  fetched=0

  # Only download when there is no binary at all; if a developer edited the
  # sources we rebuild instead of clobbering their tree with a release build.
  if [[ ! -x "$binary" && -z "${TMUX_AGENT_SIDEBAR_NO_DOWNLOAD:-}" ]]; then
    if "$script_dir/tmux-agent-sidebar-fetch" "$binary" 2>/dev/null; then
      fetched=1
    fi
  fi

  if [[ "$fetched" != 1 ]]; then
    cargo_bin="${CARGO_BIN:-$(command -v cargo || true)}"
    if [[ -z "$cargo_bin" && -x "$HOME/.cargo/bin/cargo" ]]; then
      cargo_bin="$HOME/.cargo/bin/cargo"
    fi
    if [[ -z "$cargo_bin" ]]; then
      cat >&2 <<'EOF'
tmux-agent-sidebar: no prebuilt binary for this platform and cargo was not found.
Install Rust from https://rustup.rs and reopen, or download a release binary from
https://github.com/Ymirke/tmux-agent-sidebar/releases
EOF
      exit 127
    fi
    "$cargo_bin" build --quiet --release --manifest-path "$repo_dir/Cargo.toml"
  fi
fi

exec "$binary" "$@"
